<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_locomotion</name>
  <version>0.1.0</version>
  <description>Unitree Go2 locomotion control: /cmd_vel to SDK or NN policy</description>
  <maintainer email="wjdtmdghkss@gmail.com">csh</maintainer>
